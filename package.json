{
  "name": "feedcal",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "node scripts/db-reset.mjs",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript > packages/shared/src/database.types.ts",
    "dev:web": "npm run dev -w @feedcal/web",
    "test:functions": "deno test --no-prompt --allow-read=supabase/functions supabase/functions && deno check supabase/functions/*/index.ts",
    "db:states": "node scripts/gen-state-machines.mjs",
    "zcta:load": "node scripts/load-zcta.mjs",
    "test:integration": "FEEDCAL_INTEGRATION=1 vitest run --no-file-parallelism tests/integration",
    "test:load": "FEEDCAL_LOAD=1 vitest run --no-file-parallelism --silent=false tests/load"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/young-serif": "5.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "linkedom": "0.18.14",
    "pdf-lib": "1.17.1",
    "postal-mime": "4.2.0",
    "supabase": "^3.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unpdf": "2.1.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
