{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * +*)",
      "Bash(supabase db push *)",
      "Bash(npx supabase db push*)",
      "Bash(* db reset * --linked*)",
      "Bash(* db reset --linked*)",
      "Bash(* db reset * --db-url*)",
      "Bash(* db reset --db-url*)",
      "Bash(supabase link *)",
      "Bash(npx supabase link*)",
      "Bash(* supabase projects delete*)",
      "Bash(supabase projects delete*)",
      "Bash(* wrangler pages deploy*)",
      "Bash(wrangler pages deploy*)",
      "Bash(* wrangler pages project delete*)",
      "Bash(wrangler pages project delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh run delete*)",
      "Bash(gh release delete*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * --method PUT*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api --method PUT*)",
      "Read(./apps/web/.dev.vars)",
      "Read(./apps/email-worker/.dev.vars)",
      "Read(./supabase/functions/.env)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
