{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db reset --linked:*)",
      "Bash(npx supabase db reset --linked:*)",
      "Bash(supabase db reset --db-url:*)",
      "Bash(npx supabase db reset --db-url:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase link:*)",
      "Bash(supabase projects delete:*)",
      "Bash(npx supabase projects delete:*)",
      "Bash(wrangler pages deploy:*)",
      "Bash(npx wrangler pages deploy:*)",
      "Bash(wrangler pages project delete:*)",
      "Bash(npx wrangler pages project delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh api --method PUT:*)",
      "Bash(gh run delete:*)",
      "Read(./apps/web/.dev.vars)",
      "Read(./apps/email-worker/.dev.vars)",
      "Read(./supabase/functions/.env)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
